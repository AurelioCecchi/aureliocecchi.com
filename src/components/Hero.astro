---
import { testi, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = testi[lang];
const h = t.home.hero;
---

<section class="hero" aria-labelledby="hero-titolo">
  <div class="contenitore">
    <h1 id="hero-titolo">{h.titolo}</h1>
    <div class="hero__base">
      <div>
        <p class="hero__lead">{h.testo}</p>
        <div class="azioni">
          <a class="bottone" href="#progetti">{h.bottoneProgetto}</a>
        </div>
      </div>
      <dl class="scheda">
        {t.home.scheda.map(({ voce, valore }) => (
          <div>
            <dt>{voce}</dt>
            <dd>{valore}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
