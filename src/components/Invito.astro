---
import { rotte, testi, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const i = testi[lang].home.invito;
---

<section class="invito" aria-labelledby="invito-titolo">
  <div class="contenitore invito__riga">
    <div class="invito__testo">
      <h2 id="invito-titolo">{i.titolo}</h2>
      <p>{i.testo}</p>
    </div>
    <a class="bottone bottone--chiaro" href={rotte.contatti[lang]}>{i.bottone}</a>
  </div>
</section>
