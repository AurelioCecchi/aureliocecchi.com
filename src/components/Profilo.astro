---
import { testi, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = testi[lang].home.profilo;
---

<section class="sezione foglio foglio--inizio profilo" id="profilo" aria-labelledby="profilo-titolo">
  <div class="contenitore binario">
    <h2 class="binario__lato binario__lato--fisso" id="profilo-titolo" data-rivela>{p.titolo}</h2>
    <div class="binario__corpo testo-lungo">
      {p.paragrafi.map((paragrafo, i) => (
        typeof paragrafo === 'string'
          ? <p data-rivela style={`--ritardo:${i * 0.08}s`}>{paragrafo}</p>
          : <p data-rivela style={`--ritardo:${i * 0.08}s`}>{paragrafo.prima}<a href={paragrafo.link.url}>{paragrafo.link.testo}</a>{paragrafo.dopo}</p>
      ))}
    </div>
  </div>
</section>
