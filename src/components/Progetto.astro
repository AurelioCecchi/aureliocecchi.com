---
import Sfondo from './Sfondo.astro';
import { lingueSito, rotte, testi, type Lang } from '../i18n';

interface Props { lang: Lang; indice?: number; }
const { lang, indice = 0 } = Astro.props;
const t = testi[lang];
const p = t.progetti[indice];
const s = t.interfaccia.caseStudio;

// La data è ISO (AAAA-MM-GG) nei dati; qui la scrivo per esteso nella lingua della pagina.
const agg = p.risultati?.aggiornamento ?? null;
const dataAgg = agg
  ? new Intl.DateTimeFormat(lingueSito[lang].og.replace('_', '-'), {
      day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
    }).format(new Date(agg.data))
  : '';
---

<header class="progetto__testa scuro scuro--sfondo">
  <Sfondo />
  <div class="contenitore">
    <a class="progetto__indietro" href={`${rotte.home[lang]}#progetti`}>
      <span aria-hidden="true">←</span> {t.interfaccia.progetti}
    </a>
    {/* Stesso nome di transizione del titolo nella scheda in home. */}
    <h1 id="progetto-titolo" style={`view-transition-name:progetto-titolo-${indice}`}>{p.titolo}</h1>
    {p.sottotitolo && <p class="progetto__sottotitolo">{p.sottotitolo}</p>}
  </div>
</header>

<section class="sezione foglio foglio--inizio foglio--fine" id="progetto" aria-labelledby="progetto-titolo">
  <div class="contenitore binario progetto__corpo">
    <div class="binario__lato binario__lato--fisso" data-rivela>
      <dl class="dettagli dettagli--scheda">
        {p.metadati.cliente && (
          <div>
            <dt>{s.cliente}</dt>
            <dd>{p.metadati.cliente}</dd>
          </div>
        )}
        <div>
          <dt>{s.settore}</dt>
          <dd>{p.metadati.settore}</dd>
        </div>
        <div>
          <dt>{s.periodo}</dt>
          <dd>{p.metadati.periodo}</dd>
        </div>
        <div>
          <dt>{s.ruolo}</dt>
          <dd>{p.metadati.ruolo}</dd>
        </div>
        <div>
          <dt>{s.stack}</dt>
          <dd>
            <ul class="progetto__stack">
              {p.metadati.stack.map((voce) => <li>{voce}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <div class="binario__corpo">
      <section class="progetto__sezione" aria-labelledby="progetto-problema">
        <h2 id="progetto-problema" data-rivela>{s.problema}</h2>
        <div class="testo-lungo" data-rivela>
          {p.problema.map((paragrafo) => <p>{paragrafo}</p>)}
        </div>
      </section>

      {p.architettura && (
        <section class="progetto__sezione" aria-labelledby="progetto-architettura">
          <h2 id="progetto-architettura" data-rivela>{s.architettura}</h2>
          <div class="testo-lungo" data-rivela>
            {p.architettura.paragrafi.map((paragrafo) => <p>{paragrafo}</p>)}
          </div>
          <figure class="progetto__figura" data-rivela>
            <div class="progetto__cornice">
              {p.architettura.immagine.src ? (
                <img src={p.architettura.immagine.src} alt={p.architettura.immagine.alt} width="1000" height="660" loading="lazy" decoding="async" />
              ) : (
                <div class="progetto__placeholder" role="img" aria-label={p.architettura.immagine.alt}>
                  {s.immagineInArrivo}
                </div>
              )}
            </div>
            <figcaption class="progetto__didascalia">{p.architettura.immagine.didascalia}</figcaption>
          </figure>
        </section>
      )}

      <section class="progetto__sezione" aria-labelledby="progetto-decisioni">
        <h2 id="progetto-decisioni" data-rivela>{s.decisioni}</h2>
        <div class="decisioni">
          {p.decisioni.map((d) => (
            <article class="decisione" data-rivela>
              <p class="decisione__scelta">{d.scelta}</p>
              <p class="decisione__perche">{d.perche}</p>
              <span class="decisione__alternativa-etichetta">{s.alternativaScartata}</span>
              <p class="decisione__alternativa">{d.alternativa}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="progetto__sezione" aria-labelledby="progetto-consegne">
        <h2 id="progetto-consegne" data-rivela>{s.consegne}</h2>
        <ul class="consegne" data-rivela>
          {p.consegne.map((voce) => <li>{voce}</li>)}
        </ul>
      </section>

      {p.risultati && (
        <section class="progetto__sezione" aria-labelledby="progetto-risultati">
          <h2 id="progetto-risultati" data-rivela>{s.risultati}</h2>
          <ul class="risultati__strutturali">
            {p.risultati.strutturali.map((voce, i) => <li data-rivela style={`--ritardo:${i * 0.06}s`}>{voce}</li>)}
          </ul>
          {agg && (
            <p class="risultati__aggiornamento" data-rivela>
              <time datetime={agg.data}>{s.aggiornamentoAl} {dataAgg}</time>
              {agg.testo}
            </p>
          )}
        </section>
      )}

      <div class="azioni progetto__chiusura">
        {p.link ? (
          <a class="bottone bottone--esterno" href={p.link.url}>{p.link.testo}</a>
        ) : (
          <a class="bottone bottone--freccia" href={rotte.contatti[lang]}>{t.home.invito.bottone}</a>
        )}
        {p.linkAutore && (
          <a class="bottone bottone--secondario" href={p.linkAutore.url}>{p.linkAutore.testo}</a>
        )}
      </div>
    </div>
  </div>
</section>
