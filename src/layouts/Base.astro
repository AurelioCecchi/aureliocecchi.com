---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'it' | 'es';
}

const { title, description, lang = 'it' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="alternate" hreflang="it" href="https://aureliocecchi.com/" />
    <link rel="alternate" hreflang="es" href="https://aureliocecchi.com/es/" />
    <link rel="alternate" hreflang="x-default" href="https://aureliocecchi.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'it_IT'} />
  </head>
  <body>
    <slot />
  </body>
</html>